{
  "name": "rust-client-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/generate-content-dates.mjs",
    "build": "next build",
    "check": "npm run lint && npm run types:check && npm run test:unit && npm run build",
    "check:seo": "node scripts/check-seo.mjs",
    "predev": "node scripts/generate-content-dates.mjs",
    "dev": "next dev",
    "start": "next start",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx && node scripts/generate-content-dates.mjs",
    "lint": "npm run check:seo && biome check",
    "lint:fix": "biome check --write --unsafe",
    "format": "biome format --write",
    "test:unit": "vitest run tests/unit",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@posthog/nextjs-config": "^1.9.29",
    "fumadocs-core": "16.8.1",
    "fumadocs-mdx": "14.3.1",
    "fumadocs-ui": "16.8.1",
    "lucide-react": "^1.8.0",
    "next": "16.2.4",
    "posthog-js": "^1.374.2",
    "posthog-node": "^5.34.6",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
