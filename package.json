{
  "name": "rust-client-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/generate-content-dates.mjs",
    "build": "next build --webpack",
    "check": "npm run check:content-dates && npm run lint && npm run types:check && npm run test:unit && npm run test:components && npm run build",
    "check:content-dates": "node scripts/generate-content-dates.mjs --check",
    "check:seo": "node scripts/check-seo.mjs",
    "predev": "node scripts/generate-content-dates.mjs",
    "dev": "next dev",
    "start": "NODE_ENV=production node server.mjs",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx && node scripts/generate-content-dates.mjs",
    "lint": "npm run check:seo && biome check",
    "lint:fix": "biome check --write --unsafe",
    "format": "biome format --write",
    "test:components": "vitest run tests/components",
    "test:components:watch": "vitest tests/components",
    "test:agent-readiness": "node tests/integration/agent-readiness.mjs",
    "test:content-negotiation": "node tests/integration/content-negotiation.mjs",
    "test:unit": "vitest run tests/unit",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@posthog/nextjs-config": "^1.9.67",
    "fumadocs-core": "16.10.3",
    "fumadocs-mdx": "15.0.12",
    "fumadocs-ui": "16.10.3",
    "lucide-react": "^1.18.0",
    "next": "16.2.9",
    "posthog-js": "^1.386.8",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/mdx": "^2.0.14",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.19"
    }
  }
}
